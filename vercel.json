{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "git": {
    "deploymentEnabled": {
      "codex/lot-2a-pro-core": false
    }
  },
  "regions": [
    "fra1"
  ],
  "crons": [
    {
      "path": "/api/cron/cycle-grace",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/notifications",
      "schedule": "15 2 * * *"
    },
    {
      "path": "/api/cron/purge",
      "schedule": "30 2 * * *"
    },
    {
      "path": "/api/cron/schema",
      "schedule": "45 2 * * *"
    }
  ]
}
