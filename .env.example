# =============================================================================
# Sika — Variables d'environnement
# Copiez ce fichier en `.env.local` et remplissez les valeurs.
# Ne versionnez jamais `.env.local` : il contient des secrets.
# =============================================================================

# ─── Supabase (obligatoire) ──────────────────────────────────────────────────
# En local : les trois valeurs sont affichées par `npx supabase start`.
# En hébergé : Dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL="https://<ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Clé service_role — JAMAIS exposée au navigateur, jamais préfixée NEXT_PUBLIC_.
# Nécessaire pour : génération des quittances, notification FedaPay, file
# d'emails, purge des fichiers, limitation des tentatives de connexion.
SUPABASE_SERVICE_ROLE_KEY=""

# ─── Site ────────────────────────────────────────────────────────────────────
# URL publique, utilisée pour les liens d'email et le retour de paiement.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Nom du produit, utilisé dans les emails et les métadonnées.
APP_NAME="Sikaloc"

# ─── FedaPay — abonnement Mobile Money ───────────────────────────────────────
# Console FedaPay → Workbench → API Keys. Le préfixe de la clé secrète
# détermine l'environnement : `sk_sandbox_…` ne touchera jamais la production.
FEDAPAY_PUBLIC_KEY=""
FEDAPAY_SECRET_KEY=""
FEDAPAY_ENV="sandbox"

# Secret du webhook — Workbench → onglet Webhooks → « Click to reveal ».
# Facultatif : sans lui la signature n'est pas vérifiée, mais le crédit
# d'abonnement reste conditionné à la revérification de la transaction auprès
# de l'API FedaPay.
FEDAPAY_WEBHOOK_SECRET=""

# ─── Resend — emails transactionnels ─────────────────────────────────────────
# Sans domaine vérifié, utiliser l'expéditeur de test onboarding@resend.dev.
RESEND_API_KEY=""
EMAIL_FROM="no-reply@sikaloc.com"
EMAIL_FROM_NAME="Sikaloc"

# ─── Tâches planifiées ───────────────────────────────────────────────────────
# Protège /api/cron/notifications et /api/cron/purge. Sans cette valeur, les
# deux routes refusent toute requête — mieux vaut une tâche qui ne tourne pas
# qu'un endpoint de purge ouvert. Générer avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=""

# Numéro WhatsApp du support avant-vente, au format international.
# Tant qu'il est absent, le bouton flottant ne s'affiche pas du tout : un lien
# vers un numéro invalide affiche une erreur WhatsApp, ce qui est pire que pas
# de bouton. Exemple : NEXT_PUBLIC_WHATSAPP_SUPPORT="+229 97 00 00 00"
NEXT_PUBLIC_WHATSAPP_SUPPORT=""

# Adresse qui reçoit les alertes de surveillance (contrôle de schéma nocturne).
# DOIT être une adresse réellement relevée : sans elle, la tâche refuse
# d'envoyer plutôt que de faire rebondir ses alertes en silence.
EMAIL_EXPLOITATION=

# Vérification de propriété du site auprès des moteurs. Renseignez puis
# redéployez : la balise apparaît seule, aucun changement de code.
VERIFICATION_GOOGLE=
VERIFICATION_BING=

# ─── Vérification du compte par code (Sikaloc 8.2) ───────────────────────────
#
# OTP_SECRET — le poivre des empreintes de codes téléphone.
#
# OBLIGATOIRE pour que la vérification du numéro fonctionne. Sans elle, le
# serveur REFUSE de générer un code plutôt que de stocker une empreinte faible :
# six chiffres hachés sans secret se retrouvent en une milliseconde si la table
# fuite, ce qui donnerait une sécurité affichée mais absente.
#
# La vérification de l'EMAIL n'en dépend pas : elle passe par GoTrue, qui gère
# son propre code (voir `otp_length` dans supabase/config.toml).
#
# 32 caractères minimum. Générer avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTP_SECRET=""

# ─── Envoi des codes au téléphone — AUCUN FOURNISSEUR CONFIGURÉ ──────────────
#
# En l'état, Sikaloc ne peut envoyer ni SMS ni message WhatsApp : les deux
# canaux se déclarent indisponibles, et l'écran de vérification le dit au
# bailleur au lieu de faire semblant d'envoyer.
#
# Renseigner ces variables rend le canal « disponible » aux yeux de
# `src/lib/verification/canaux.ts` — mais le transport lui-même reste à écrire
# dans ce fichier, une fois le fournisseur choisi. C'est volontaire : la forme
# de la requête dépend du fournisseur, et du code jamais exécuté serait du code
# faux.
#
# SMS — un fournisseur couvrant le Bénin (Twilio, Vonage, agrégateur local).
SMS_FOURNISSEUR=""
SMS_IDENTIFIANT=""
SMS_JETON=""
SMS_EXPEDITEUR=""

# WhatsApp — WhatsApp Business Platform (Meta Cloud API) ou Twilio WhatsApp.
# Un gabarit de message d'authentification approuvé par Meta est requis : les
# messages hors gabarit sont refusés à l'envoi sortant.
WHATSAPP_ID_TELEPHONE=""
WHATSAPP_JETON=""

# OTP_CANAL_DEV — trappe de développement, hors production uniquement.
#
# À « 1 », les codes téléphone ne partent pas : ils s'affichent dans la console
# du serveur. Permet d'essayer le parcours complet avant d'avoir un contrat
# opérateur.
#
# Sans effet dès que NODE_ENV vaut « production » — donc sans effet sur Vercel,
# quoi qu'on écrive ici. C'est ce qui garantit qu'aucun code ne sera jamais
# journalisé en production.
OTP_CANAL_DEV=""
